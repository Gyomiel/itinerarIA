{% extends 'base.html.twig' %}

{% block title %}Route{% endblock %}

{% block body %}
    <h1>Route</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ route.id }}</td>
            </tr>
            <tr>
                <th>Route_date</th>
                <td>{{ route.routeDate ? route.routeDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Estimated_duration</th>
                <td>{{ route.estimatedDuration ? route.estimatedDuration|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Total_distance</th>
                <td>{{ route.totalDistance }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_route_index') }}">back to list</a>

    <a href="{{ path('app_route_edit', {'id': route.id}) }}">edit</a>

    {{ include('route/_delete_form.html.twig') }}
{% endblock %}
