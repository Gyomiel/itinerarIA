{% extends 'base.html.twig' %}

{% block title %}Order index{% endblock %}

{% block body %}
    <h1>Order index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Delivery_date</th>
                <th>Delivery_address</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Box_type</th>
                <th>Maximum_permissible_mass</th>
                <th>Maximum_permissible_volume</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for order in orders %}
            <tr>
                <td>{{ order.id }}</td>
                <td>{{ order.deliveryDate ? order.deliveryDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ order.deliveryAddress }}</td>
                <td>{{ order.latitude }}</td>
                <td>{{ order.longitude }}</td>
                <td>{{ order.boxType }}</td>
                <td>{{ order.maximumPermissibleMass }}</td>
                <td>{{ order.maximumPermissibleVolume }}</td>
                <td>
                    <a href="{{ path('app_order_show', {'id': order.id}) }}">show</a>
                    <a href="{{ path('app_order_edit', {'id': order.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_order_new') }}">Create new</a>
{% endblock %}
