<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}
				itinerarIA | Home
			{% endblock %}
		</title>

		<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">


		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
			<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
			<link rel="icon" href="{{ asset('imgs/favicon.png') }}" type="image/x-icon">

		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
			{{ importmap() }}
		{% endblock %}
	</head>
	<body class="flex flex-col min-h-screen">
		{% block header %}

			<nav class="bg-[#4DBAA8] border-gray-200">
				<div class="bg-[#4DBAA8] flex items-center justify-between p-6">
					<a href="{{ path('home') }}" class="ml-4 flex items-center space-x-3 rtl:space-x-reverse h-10">
						<img src="{{ asset('imgs/alterLogoBW.png') }}" id="logo"/>
					</a>
					<div class="mr-6 bg-[#4DBAA8] items-center md:flex md:w-auto md:order-1 ml-auto space-x-8" id="navbar-cta">
						<ul class="bg-[#4DBAA8] flex flex-col justify-center items-center font-semibold text-xl p-4">
							<li class="bg-[#4DBAA8] flex items-center">
								<a href="#" class="bg-[#4DBAA8] block text-white font-bold text-[24px] hover:text-black">LOGIN</a>
							</li>
						</ul>

						<a class="fancy" href="#">
							<span class="top-key"></span>
							<span class="text">Schedule a demo</span>
							<span class="bottom-key-1"></span>
							<span class="bottom-key-2"></span>
						</a>
					</div>
				</div>
			</nav>


			<style>
				.fancy {
					background-color: transparent;
					border: 2px solid #131515;
					border-radius: 0;
					box-sizing: border-box;
					color: #fff;
					cursor: pointer;
					display: inline-block;
					float: right;
					font-weight: 700;
					letter-spacing: 0.05em;
					margin: 0;
					outline: none;
					overflow: visible;
					padding: 1.25em 2em;
					position: relative;
					text-align: center;
					text-decoration: none;
					text-transform: none;
					transition: all 0.3s ease-in-out;
					user-select: none;
					font-size: 13px;
				}

				.fancy::before {
					content: " ";
					width: 1.5625rem;
					height: 2px;
					background: black;
					top: 50%;
					left: 1.5em;
					position: absolute;
					transform: translateY(-50%);
					transform-origin: center;
					transition: background 0.3s linear, width 0.3s linear;
				}

				.fancy .text {
					font-size: 24px;
					line-height: 1.33333em;
					padding-left: 2em;
					display: block;
					text-align: left;
					transition: all 0.3s ease-in-out;
					text-transform: uppercase;
					text-decoration: none;
					font-weight: 700;
					color: black;
				}

				.fancy .top-key {
					height: 2px;
					width: 1.5625rem;
					top: -2px;
					left: 0.625rem;
					position: absolute;
					background: #e8e8e8;
					transition: width 0.5s ease-out, left 0.3s ease-out;
				}

				.fancy .bottom-key-1 {
					height: 2px;
					width: 1.5625rem;
					right: 1.875rem;
					bottom: -2px;
					position: absolute;
					background: #e8e8e8;
					transition: width 0.5s ease-out, right 0.3s ease-out;
				}

				.fancy .bottom-key-2 {
					height: 2px;
					width: 0.625rem;
					right: 0.625rem;
					bottom: -2px;
					position: absolute;
					background: #e8e8e8;
					transition: width 0.5s ease-out, right 0.3s ease-out;
				}

				.fancy:hover {
					color: white;
					background: #2B2C28;

				}

				.fancy:hover::before {
					width: 0.9375rem;
					background: white;
				}

				.fancy:hover .text {
					color: white;
					padding-left: 1.5em;
				}

				.fancy:hover .top-key {
					left: -2px;
					width: 0;
				}

				.fancy:hover .bottom-key-1,
				.fancy:hover .bottom-key-2 {
					right: 0;
					width: 0;
				}

				#logo {
					height: 55px;
				}
			</style>

		{% endblock %}

		{% block body %}{% endblock %}


		{% block footer %}
			<footer class="w-full bg-[#1C2541] shadow self-end">
				<div class="w-full mx-auto max-w-screen-xl p-4 text-center">
					<span class="text-sm text-slate-100">
						© 2025
						<span class="font-bold">itinerar<span class="text-[#7DE2D1]">IA</span>
						</span>
						by
						<a href="https://github.com/zoraidafalcon" class="font-bold hover:underline">Ana Zoraida Falcón</a>,
						<a href="https://github.com/AngelRodriguez66" class="font-bold hover:underline">Ángel Rodríguez</a>,
						<a href="https://github.com/LkYharlan" class="font-bold hover:underline">Daniel Moreno</a>,
						<a href="https://github.com/Jezabel-sh" class="font-bold hover:underline">Jezabel Sánchez</a>,
						<a href="https://github.com/Gyomiel" class="font-bold hover:underline">Marta de la Rosa</a>.
																																																												All Rights Reserved.
					</span>
				</div>
			</footer>

		{% endblock %}

	</body>
</html></body></html>
