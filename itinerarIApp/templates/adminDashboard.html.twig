{% extends "base.html.twig" %}

{% block body %}

	<head>
		<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
		<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
	</head>

	<div
		class="grid grid-cols-2 h-[81.2vh]">
		{{dump(posts)}} 
{{ pagination | raw }}
		<div class="w-[800px] max-h-[600px] rounded-sm p-2 flex flex-col justify-center items-center gap-1 m-auto overflow-y-scroll">

			{% for item in order %}
				<div id="toggleDiv" class="flex-1 group flex-col cursor-pointer border-4 border-[#2B2C28] flex items-center transition-all duration-500 bg-[#FFFAFB] hover:flex-[8] focus-within:flex-[8] w-full">
					<div class="flex gap-6">
						<span class="mx-5 p-2 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
							<strong>Order ID:</strong>
							{{item.id}}
						</span>
						<span class="mx-5 p-2 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
							<strong>Customer ID:</strong>
							{{item.customer.id}}
						</span>

						<span class="mx-5 p-2 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
							<strong>Assigned route:</strong>
							{{ item.route is not null ? item.route : 'N/A'}}
						</span>

					</div>

					<div class="extraContent hidden group-hover:flex group-hover:flex-col text-[#2B2C28] transition-opacity uppercase duration-500 ease-in-out">
						<div class="flex">
							<span class="p-2 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
								<strong>Address:</strong>
								{{item.deliveryAddress}}
							</span>
						</div>
						<div class="flex w-full justify-around">
							<div class="flex flex-col items-start">
								<span class="p-2 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
									<strong>Name:</strong>
									{{item.customer.firstName}}
									{{item.customer.lastName}}
								</span>
								<span class="p-2 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
									<strong>Phone:</strong>
									{{item.customer.phone}}
								</span>
							</div>
							<div class="flex flex-col items-start">
								<span class="p-2 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
									<strong>National ID:</strong>
									{{item.customer.nationalIdNumber}}
								</span>

								<span class="p-2 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
									<strong>Box Size:</strong>
									{{item.boxType}}
								</span>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}
			
			

		</div>

		<div class="m-auto">
			<div id="map"></div>

			<a href="{{ path('home') }}" class="">
				<div class="sp">
					<button class="sparkle-button">
						<span class="spark"></span>
						<span class="backdrop"></span>
