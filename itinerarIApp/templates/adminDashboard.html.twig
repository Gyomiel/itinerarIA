const toggleDiv = (e) => {
let content = e.target.closest('.extraContent')
if (content.classList.contains("hidden")) {
content.classList.remove("hidden");
content.classList.add("flex");
content.classList.add("flex-col");


} else {
content.classList.remove("flex");
content.classList.remove("flex-col");
content.classList.add("hidden");
}
};

const elements = [...document.getElementsByClassName('extraContent')]
elements.forEach((el) => {

if (el.classList.contains("extraContent")) {
el.addEventListener('click', (e) => {
toggleDiv(e)
}, false)
}
})
	</script>


