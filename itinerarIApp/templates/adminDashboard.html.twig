{% extends "base.html.twig" %}

{% block section %}
	<title>
		{% block title %}itinerarIA | Admin Dashboard
		{% endblock %}
	</title>

{% endblock %}


{% block body %}

	<head>
		<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
		<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
	</head>

	<div
		class="grid grid-cols-2 h-[80.6vh] m-auto gap-10" id="blurBg">
		{# {{dump(orderInfo)}} #}
		<div class="flex flex-col justify-center items-center">
			<div class="w-[800px] max-h-[700px] rounded-sm flex flex-col justify-center items-center gap-1 mx-auto">
				{% for item in posts %}
					<div id="toggleDiv" class="flex-1 group flex-col cursor-pointer border-4 border-[#2B2C28] flex items-center transition-all duration-500 bg-[#FFFAFB] hover:flex-[8] focus-within:flex-[8] w-full">
						<div class="flex gap-6 p-2">
							<span class="mx-5 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
								<strong>Order ID:</strong>
								{{item.id}}
							</span>
							<span class="mx-5 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
								<strong>Customer ID:</strong>
								{{item.customer.id}}
							</span>

							<span class="mx-5 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
								<strong>Assigned route:</strong>
								{{ item.route is not null ? item.route.id : 'N/A'}}
							</span>

						</div>

						<div class="extraContent hidden group-hover:flex group-hover:flex-col text-[#2B2C28] transition-opacity uppercase duration-500 ease-in-out">
							<div class="flex">
								<span class="pb-2 text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
									<strong>Address:</strong>
									{{item.deliveryAddress}}
								</span>
							</div>
							<div class="flex w-full justify-around">
								<div class="flex flex-col items-start pb-2">
									<span class="text-center pb-1 text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
										<strong>Name:</strong>
										{{item.customer.firstName}}
										{{item.customer.lastName}}
									</span>
									<span class="text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
										<strong>Phone:</strong>
										{{item.customer.phone}}
									</span>
								</div>
								<div class="flex flex-col items-start">
									<span class="text-center pb-1 text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
										<strong>National ID:</strong>
										{{item.customer.nationalIdNumber}}
									</span>

									<span class="text-center text-[#2B2C28] uppercase tracking-wider transition-all duration-500">
										<strong>Box Size:</strong>
										{{item.boxType}}
									</span>
								</div>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>

			<div class="pagination">
				{{ pagination | raw }}
			</div>

		</div>

		<div class="m-auto">
			<div id="map"></div>

			<div class="btnWrapper">
				<a href="{{ path('optimize') }}" id="generateRoutesLink">
					<button class="button" id="generateRoutesButton">
						<div class="dots_border"></div>
						<svg xmlns="http://www.w3.org/2000/svg" fill="#000" viewbox="0 0 24 24" class="sparkle">
							<path class="path" stroke-linejoin="round" stroke-linecap="round" stroke="black" fill="#000" d="M14.187 8.096L15 5.25L15.813 8.096C16.0231 8.83114 16.4171 9.50062 16.9577 10.0413C17.4984 10.5819 18.1679 10.9759 18.903 11.186L21.75 12L18.904 12.813C18.1689 13.0231 17.4994 13.4171 16.9587 13.9577C16.4181 14.4984 16.0241 15.1679 15.814 15.903L15 18.75L14.187 15.904C13.9769 15.1689 13.5829 14.4994 13.0423 13.9587C12.5016 13.4181 11.8321 13.0241 11.097 12.814L8.25 12L11.096 11.187C11.8311 10.9769 12.5006 10.5829 13.0413 10.0423C13.5819 9.50162 13.9759 8.83214 14.186 8.097L14.187 8.096Z"></path>

							<path class="path" stroke-linejoin="round" stroke-linecap="round" stroke="black" fill="#000" d="M6 14.25L5.741 15.285C5.59267 15.8785 5.28579 16.4206 4.85319 16.8532C4.42059 17.2858 3.87853 17.5927 3.285 17.741L2.25 18L3.285 18.259C3.87853 18.4073 4.42059 18.7142 4.85319 19.1468C5.28579 19.5794 5.59267 20.1215 5.741 20.715L6 21.75L6.259 20.715C6.40725 20.1216 6.71398 19.5796 7.14639 19.147C7.5788 18.7144 8.12065 18.4075 8.714 18.259L9.75 18L8.714 17.741C8.12065 17.5925 7.5788 17.2856 7.14639 16.853C6.71398 16.4204 6.40725 15.8784 6.259 15.285L6 14.25Z"></path>

